<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<restG4>
  <globals>
    <parameter name="mainDataPath" value="" />
    <parameter name="verboseLevel" value="essential" />
  </globals>

  <TRestRun name="Run" title="NvDEX PhaseC XeTMA mode1">
    <parameter name="experiment" value="NvDEX"/>
    <parameter name="runType" value="simulation"/>
    <parameter name="runNumber" value="8601"/>
    <parameter name="runTag" value="phaseC_xetma1pct10atm_mode1"/>
    <parameter name="runDescription" value="Phase C prep inline decay0 mode 1 Geant4 sample"/>
    <parameter name="user" value="${USER}"/>
    <parameter name="verboseLevel" value="1"/>
    <parameter name="overwrite" value="on" />
    <parameter name="outputFile" value="phaseC_mode1_g4.root" />
  </TRestRun>

  <TRestG4Metadata name="DBDsimulation" title="PhaseC XeTMA mode1">
    <parameter name="Nevents" value="200"/>
    <parameter name="gdml_file" value="/lustrefs/juno26/users/wuwenjie/rest/REST-for-NvDEX-root638/workspace/Geometry/main_xetma1pct10atm.gdml"/>
    <parameter name="maxTargetStepSize" value="500" units="um" />
    <parameter name="subEventTimeDelay" value="0" units="ns" />
    <parameter name="seed" value="8601" />

    <generator type="volume" from="Gas">
      <source use="decay0" particle="Xe136" decayMode="0vbb" daughterLevel="0" dbdMode="1" />
    </generator>

    <storage sensitiveVolume="Gas">
      <parameter name="energyRange" value="(0,5)" units="MeV" />
      <activeVolume name="Gas" chance="1" />
    </storage>
  </TRestG4Metadata>

  <TRestPhysicsLists name="default" title="PhaseC physics list">
    <physicsList name="G4EmLivermorePhysics"> </physicsList>
    <physicsList name="G4DecayPhysics"> </physicsList>
  </TRestPhysicsLists>
</restG4>
