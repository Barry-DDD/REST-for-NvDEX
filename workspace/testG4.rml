<?xml version="1.0" encoding="UTF-8" standalone="no" ?>

<restG4>
  <globals>
    <parameter name="mainDataPath" value="" />
    <parameter name="verboseLevel" value="0" /> 
  </globals>

  <TRestRun name="Run" title="NvDEX">
    <parameter name="experiment" value="NvDEX-Dec"/>
    <parameter name="runType" value="simulation"/>
    <parameter name="runNumber" value="999"/>
    <parameter name="runTag" value="NvDEX"/>
    <parameter name="runDescription" value="NvDEX"/>
    <parameter name="user" value="${USER}"/>
    <parameter name="verboseLevel" value="2"/>
    <parameter name="overwrite" value="on" />
    <parameter name="outputFile" value="New_original_N=100.root" />
  </TRestRun>

  <TRestG4Metadata name="restG4 run" title="sim of gamma">

    <parameter name="Nevents" value="100"/>
    <parameter name="gdml_file" value="Geometry/main.gdml"/>
    <parameter name="maxTargetStepSize" value="500" units="um" />
    <parameter name="subEventTimeDelay" value="0" units="ns" />
    <parameter name="seed" value="999" />
  
    <generator type="point" position="(10,20,40)mm">
    <source use="Se82_0nubb_gs.dat" />
     <!-- <generator type="volume" from="Gas"> -->
     <!-- <generator type="surface" from="Gas" > -->
     <!-- <generator type="virtualCylinder" position="(0,0,0)mm" radius="445mm"
           length="1690mm" rotation="(0,0,0)" > -->
      <!-- <source use="geant4" particle="e-" excitedLevel="0.0" fullChain="off">
        <angularDist type="flux" direction="(0,0,1)"/> -->
        <!-- <angularDist type="isotropic" />  -->
        <!-- <energyDist type="mono" energy="2.99" units="MeV" />
      </source> -->

      <!-- <source use="geant4" particle="e-" excitedLevel="0.0" fullChain="off">
        <angularDist type="flux" direction="(0,0,-1)"/>
        <energyDist type="mono" energy="2.99" units="MeV" />
      </source> -->

    </generator> 

    
    <!-- <generator type="volume" from="Gas"> -->
      <!-- <source use="Se82_0nubb_gs.dat" /> -->
    <!-- </generator> -->
    <!-- <generator type="readfromfile">
    <source fromFile="se82_2nubb_pileup_time_modified.dat" /> -->
    <!-- <source fromFile="se82_2nubb_1.dat" /> -->
<!-- </generator> -->


    <!-- <generator type="volume" from="Gas">
      <source use="BiPo214.dat" />
    </generator> -->
    <storage sensitiveVolume="Gas">
      <parameter name="energyRange" value="(0,3)" units="MeV" />
      <activeVolume name="Gas" chance="1"  />
      <!-- <activeVolume name="MM" chance="1"  />
      <activeVolume name="CZTPhy" chance="1"  />
      <activeVolume name="PCBPhy" chance="1"  /> -->
    </storage>

  </TRestG4Metadata>

  <TRestPhysicsLists name="default" title="First physics list implementation." >

    <!-- <parameter name="cutForGamma" value="0.1" units="mm" />
    <parameter name="cutForElectron" value="0.01" units="mm" />
    <parameter name="cutForPositron" value="1" units="mm" />
    <parameter name="cutForMuon" value="1" units="mm" />
    <parameter name="cutForNeutron" value="1" units="mm" />
    <parameter name="minEnergyRangeProductionCuts" value="1" units="keV" />
    <parameter name="maxEnergyRangeProductionCuts" value="1" units="GeV" /> -->
 
    // Use only one EM physics list
    <!-- EM Physics lists -->
    <physicsList name="G4EmLivermorePhysics"> </physicsList>
    <!-- <physicsList name="G4EmPenelopePhysics"> </physicsList> -->
    <!-- <physicsList name="G4EmStandardPhysics_option3"> </physicsList> -->
 
    <!-- Decay physics lists -->
    <physicsList name="G4DecayPhysics"> </physicsList>
    <physicsList name="G4RadioactiveDecayPhysics"> </physicsList>
    <physicsList name="G4RadioactiveDecay">
      <option name="ICM" value="true" />
      <option name="ARM" value="true" />
    </physicsList>

    <!-- Hadron physics lists -->
    <physicsList name="G4HadronElasticPhysicsHP"> </physicsList>
    <physicsList name="G4IonBinaryCascadePhysics"> </physicsList>
    <physicsList name="G4HadronPhysicsQGSP_BIC_HP"> </physicsList>
    <physicsList name="G4NeutronTrackingCut"> </physicsList>
    <physicsList name="G4EmExtraPhysics"> </physicsList>

  </TRestPhysicsLists>


</restG4>
