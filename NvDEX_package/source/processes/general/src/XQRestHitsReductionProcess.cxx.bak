#include "XQRestHitsReductionProcess.h"
using namespace std;

ClassImp(XQRestHitsReductionProcess)
    //______________________________________________________________________________
    XQRestHitsReductionProcess::XQRestHitsReductionProcess() {
    Initialize();
}

//______________________________________________________________________________
XQRestHitsReductionProcess::XQRestHitsReductionProcess(char* cfgFileName) {
    Initialize();

    if (LoadConfigFromFile(cfgFileName) == -1) LoadDefaultConfig();
}

//______________________________________________________________________________
XQRestHitsReductionProcess::~XQRestHitsReductionProcess() {
    delete fInputHitsEvent;
    delete fOutputHitsEvent;
}

void XQRestHitsReductionProcess::LoadDefaultConfig() {
    SetName("hitsReductionProcess");
    SetTitle("Default config");

    fStartingDistance = 0.5;
    fMinimumDistance = 3;
    fDistanceFactor = 1.5;
    fStartingNodes = 300;
    fMaxNodes = 30;
    fHitsEnergy = 1;
    fEnergyRange.Set(2.395,2.520);
}

//______________________________________________________________________________
void XQRestHitsReductionProcess::Initialize() {
    SetSectionName(this->ClassName());

    fInputHitsEvent = new TRestHitsEvent();
    fOutputHitsEvent = new TRestHitsEvent();

    fOutputEvent = fOutputHitsEvent;
    fInputEvent = fInputHitsEvent;
}

void XQRestHitsReductionProcess::LoadConfig(std::string cfgFilename, std::string name) {
    if (LoadConfigFromFile(cfgFilename, name) == -1) LoadDefaultConfig();
}

//______________________________________________________________________________
void XQRestHitsReductionProcess::InitProcess() { cout << __PRETTY_FUNCTION__ << endl; }

//______________________________________________________________________________
void XQRestHitsReductionProcess::BeginOfEventProcess() { fOutputHitsEvent->Initialize(); }

//______________________________________________________________________________
TRestEvent* XQRestHitsReductionProcess::ProcessEvent(TRestEvent* evInput) {
    fInputHitsEvent = (TRestHitsEvent*)evInput;
    if( fInputHitsEvent->GetTotalEnergy() < fEnergyRange.X() ||
        fInputHitsEvent->GetTotalEnergy() > fEnergyRange.Y() ){
        cout << "XQRestHitsReductionProcess: Energy over range: " << fInputHitsEvent->GetTotalEnergy() << "keV !"<<endl;
        return NULL;
    }

    Int_t counts = 0;
    while(counts< 5){
        TRestHitsEvent *tempEvent = new TRestHitsEvent();
        // Copying the input hits event to the output hits event
        for (int h = 0; h < fInputHitsEvent->GetNumberOfHits(); h++)
          if( fInputHitsEvent->GetEnergy(h) > fHitsEnergy ){
            tempEvent->AddHit(fInputHitsEvent->GetX(h),fInputHitsEvent->GetY(h),
                                      fInputHitsEvent->GetZ(h),fInputHitsEvent->GetEnergy(h));
          }

        // Reducing the hits
        TRestHits* hits = tempEvent->GetHits();

        if(tempEvent->GetNumberOfHits() > fStartingNodes &&
              tempEvent->GetNumberOfHits() < fMaxNodes){
            //cout << counts << endl;
            for (int h = 0; h < tempEvent->GetNumberOfHits(); h++)
                fOutputHitsEvent->AddHit(tempEvent->GetX(h),tempEvent->GetY(h),
                                          tempEvent->GetZ(h),tempEvent->GetEnergy(h));
            break;
        }

        Double_t distance = fStartingDistance;
        while ( distance < fMinimumDistance || hits->GetNumberOfHits() > fMaxNodes ) {
            Bool_t merged = true;
            while (merged) {
                merged = false;
                for (int i = 0; i < hits->GetNumberOfHits(); i++) {
                    for (int j = i + 1; j < hits->GetNumberOfHits(); j++) {
                        if (hits->GetDistance2(i, j) < distance * distance) {
                            hits->MergeHits(i, j);
                            merged = true;
                        }
                    }
                }
            }
            //cout<<  hits->GetNumberOfHits() << "  " << distance << endl;
            distance *= fDistanceFactor;
        }
        //cout << hits->GetNumberOfHits() <<endl;
        if(tempEvent->GetNumberOfHits() > fStartingNodes){
            //cout << counts << endl;
            cout << distance << endl;
            for (int h = 0; h < tempEvent->GetNumberOfHits(); h++)
                fOutputHitsEvent->AddHit(tempEvent->GetX(h),tempEvent->GetY(h),
                                          tempEvent->GetZ(h),tempEvent->GetEnergy(h));
            break;
        }
        fStartingDistance /= 1.5 * fDistanceFactor;
        //delete tempEvent;
        //cout << "getout!" <<endl;
        counts ++;
    }

    if( fOutputHitsEvent->GetNumberOfHits() == 0 ){
        cout << "XQRestHitsReductionProcess: Hits Nums = 0 !"<<endl;
        return NULL;
    }

    fOutputHitsEvent->SetEventInfo(fInputHitsEvent);
    Int_t initialHits = fInputHitsEvent->GetNumberOfHits();
    Int_t finalHits = fOutputHitsEvent->GetNumberOfHits();
    //if (this->GetVerboseLevel() == REST_Debug) {
    if ( 1 ) {
        cout << "XQRestHitsReductionProcess : Initial number of hits : " << initialHits << endl;
        cout << "XQRestHitsReductionProcess : Final number of hits : " << finalHits << endl;
        cout << "XQRestHitsReductionProcess : Final energy of hits : " << fOutputHitsEvent->GetTotalEnergy() << endl;
    }

    return fOutputHitsEvent;
}

//______________________________________________________________________________
void XQRestHitsReductionProcess::EndOfEventProcess() {}

//______________________________________________________________________________
void XQRestHitsReductionProcess::EndProcess() {}

//______________________________________________________________________________
void XQRestHitsReductionProcess::InitFromConfigFile() {
    fStartingDistance = GetDblParameterWithUnits("startingDistance");
    fMinimumDistance = GetDblParameterWithUnits("minimumDistance");
    fDistanceFactor = StringToDouble(GetParameter("distanceStepFactor"));
    fStartingNodes = StringToDouble(GetParameter("StartingNodes"));
    fMaxNodes = StringToDouble(GetParameter("maxNodes"));
    fHitsEnergy = StringToDouble(GetParameter("HitsEnergy"));
    fEnergyRange = StringTo2DVector(GetParameter("EnergyRange", "(2.395,2.520)")); //MeV
}
